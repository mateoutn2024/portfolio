---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projectsData, type ProjectDetail } from '../../data/projects';
import { ArrowLeft } from 'lucide-react';

export function getStaticPaths() {
  return projectsData.map((project: ProjectDetail) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: ProjectDetail;
}

const { project } = Astro.props;
---

<BaseLayout
  title={`${project.title} | Caso de Estudio`}
  description={project.summary}
>
  <main class="mx-auto max-w-4xl flex-1 px-6 py-24">
    
    <!-- Volver al Inicio -->
    <a
      href="/#proyectos"
      class="inline-flex items-center gap-2 font-mono text-sm text-text-muted transition hover:text-accent"
    >
      <ArrowLeft className="h-4 w-4" />
      <span>Volver a proyectos</span>
    </a>

    <!-- Header del Detalle -->
    <header class="mt-8 border-b border-border-muted pb-8">
      <span class="font-mono text-xs font-semibold tracking-wider text-accent uppercase">
        {project.category}
      </span>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        {project.title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-text-muted">
        {project.summary}
      </p>

      <!-- Botón de código -->
      <div class="mt-6 flex flex-wrap gap-4">
        <a
          href={project.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white transition hover:bg-accent-hover"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
          <span>Ver Repositorio</span>
        </a>
      </div>
    </header>

    <!-- Cuerpo del Caso de Estudio -->
    <div class="mt-10 space-y-12 text-text-muted">
      
      <!-- Problema & Solución -->
      <section class="space-y-4">
        <h2 class="text-xl font-bold text-text-primary">01. El Problema & Contexto</h2>
        <p class="leading-relaxed">{project.problem}</p>
        <h3 class="pt-2 text-lg font-semibold text-text-primary">Solución Propuesta</h3>
        <p class="leading-relaxed">{project.solution}</p>
      </section>

      <!-- Arquitectura Técnica -->
      <section class="space-y-4">
        <h2 class="text-xl font-bold text-text-primary">02. Decisiones de Arquitectura</h2>
        <ul class="space-y-2">
          {project.architecture.map((item: string) => (
            <li class="flex items-start gap-2.5">
              <span class="mt-1 text-accent">▹</span>
              <span class="text-sm leading-relaxed">{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Desafíos Resueltos -->
      <section class="space-y-4">
        <h2 class="text-xl font-bold text-text-primary">03. Retos Técnicos & Aprendizajes</h2>
        <ul class="space-y-2">
          {project.challenges.map((item: string) => (
            <li class="flex items-start gap-2.5">
              <span class="mt-1 text-accent">▹</span>
              <span class="text-sm leading-relaxed">{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Stack tags -->
      <section class="border-t border-border-muted pt-6">
        <span class="font-mono text-xs text-text-muted uppercase">Tecnologías aplicadas:</span>
        <div class="mt-3 flex flex-wrap gap-2">
          {project.tags.map((tag: string) => (
            <span class="rounded-md border border-border-muted bg-bg-surface px-2.5 py-1 font-mono text-xs text-text-primary">
              {tag}
            </span>
          ))}
        </div>
      </section>

    </div>
  </main>
</BaseLayout>