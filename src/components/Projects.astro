---
import { ExternalLink } from 'lucide-react';

interface Project {
  title: string;
  category: string;
  description: string;
  highlights: string[];
  tags: string[];
  githubUrl: string;
  caseStudyUrl?: string;
}

const projects: Project[] = [
  {
    title: 'ComandaFlow — Gestión Gastronómica Integral',
    category: 'Mobile & Cloud Architecture',
    description:
      'Sistema integral para la digitalización operativa de restaurantes: recepción de clientes, control de mesas vía QR, pedidos dinámicos segmentados por áreas (cocina/bar) y control de cobros.',
    highlights: [
      'Control de acceso granular con navegación dinámica basada en roles (mozo, cocina, metre, cliente).',
      'Sincronización en vivo mediante WebSockets / Supabase Realtime para estados de comandas.',
      'Generación y lectura nativa de códigos QR para asignación y validación de mesas.',
    ],
    tags: ['React Native', 'Expo', 'Supabase', 'PostgreSQL', 'Realtime', 'TypeScript'],
    githubUrl: 'https://github.com/mateoutn2024/TFI-copia-propia.git',
    caseStudyUrl: '/proyectos/comanda-flow',
  },
  {
    title: 'SocialHub — Enterprise REST API & Platform',
    category: 'Full Stack & Backend Architecture',
    description:
      'Plataforma social modular orientada a empresas. Backend desacoplado con arquitectura limpia en NestJS y cliente dinámico en Angular con visualización analítica de interacciones en tiempo real.',
    highlights: [
      'Flujo de autenticación JWT robusto: expiración a 15 minutos, refresco de sesión y control RBAC.',
      'API REST modular con validación de estados HTTP rigurosos, paginación y bajas lógicas (soft deletes).',
      'Dashboard con métricas interactivas y gráficos de rendimiento de usuarios y publicaciones.',
    ],
    tags: ['NestJS', 'Angular', 'MongoDB', 'TypeScript', 'JWT Auth', 'REST API'],
    githubUrl: 'https://github.com/mateoutn2024/MATEO-GIGY-TRAYNOR-TP2-PROG4-2026-C1.git',
    caseStudyUrl: '/proyectos/social-hub',
  },
];
---

<section id="proyectos" class="scroll-mt-24 border-t border-border-muted/60 py-20">
  <div class="mx-auto max-w-5xl px-6">
    
    <!-- Encabezado -->
    <div class="space-y-2">
      <span class="font-mono text-xs font-semibold tracking-wider text-accent uppercase">
        Trabajo Real & Casos de Estudio
      </span>
      <h2 class="text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Proyectos Destacados
      </h2>
      <p class="max-w-2xl text-base text-text-muted">
        Aplicaciones completas donde aplico patrones de arquitectura, modelado de bases de datos y seguridad.
      </p>
    </div>

    <!-- Lista de Proyectos -->
    <div class="mt-12 space-y-12">
      {projects.map((project) => (
        <article class="flex flex-col gap-6 rounded-2xl border border-border-muted bg-bg-surface p-6 sm:p-8 transition hover:border-accent/40">
          
          <!-- Encabezado del Proyecto -->
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border-muted/60 pb-4">
            <div>
              <span class="font-mono text-xs font-medium text-accent">
                {project.category}
              </span>
              <h3 class="mt-1 text-2xl font-bold tracking-tight text-text-primary">
                {project.title}
              </h3>
            </div>
            
            <!-- Links rápidos -->
            <div class="flex items-center gap-3">
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-lg border border-border-muted bg-bg-primary/50 px-3 py-1.5 text-xs font-medium text-text-muted transition hover:border-accent hover:text-text-primary"
              >
                <!-- SVG nativo GitHub -->
                <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
                </svg>
                <span>Código</span>
              </a>
              {project.caseStudyUrl && (
                <a
                  href={project.caseStudyUrl}
                  class="inline-flex items-center gap-1.5 rounded-lg border border-accent/30 bg-accent/10 px-3 py-1.5 text-xs font-medium text-accent transition hover:bg-accent hover:text-white"
                >
                  <ExternalLink className="h-3.5 w-3.5" />
                  <span>Detalle Técnico</span>
                </a>
              )}
            </div>
          </div>

          <!-- Descripción del problema -->
          <p class="text-base leading-relaxed text-text-muted">
            {project.description}
          </p>

          <!-- Puntos destacados de ingeniería -->
          <div class="space-y-2">
            <h4 class="font-mono text-xs font-semibold tracking-wider text-text-primary uppercase">
              Aspectos Técnicos Destacados
            </h4>
            <ul class="space-y-1.5">
              {project.highlights.map((highlight) => (
                <li class="flex items-start gap-2 text-sm text-text-muted">
                  <span class="mt-1 text-accent">▹</span>
                  <span>{highlight}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Tags del Stack -->
          <div class="flex flex-wrap gap-2 pt-2">
            {project.tags.map((tag) => (
              <span class="inline-flex items-center rounded-md border border-border-muted bg-bg-primary/70 px-2.5 py-1 font-mono text-xs text-text-primary">
                {tag}
              </span>
            ))}
          </div>

        </article>
      ))}
    </div>

  </div>
</section>