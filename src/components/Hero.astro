---
import { ArrowRight, Download } from 'lucide-react';
---

<section class="relative pt-24 pb-20 md:pt-32 md:pb-28">
  <!-- Glow ambiental sutil de fondo -->
  <div
    class="pointer-events-none absolute top-1/4 left-1/2 -z-10 h-64 w-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent/15 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="mx-auto max-w-5xl px-6">
    <div class="max-w-3xl space-y-6">
      
      <!-- Badge de disponibilidad -->
      <div class="inline-flex items-center gap-2 rounded-full border border-border-muted bg-bg-surface px-3 py-1 text-xs font-medium text-text-muted">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        <span>Disponible para nuevos desafíos profesionales</span>
      </div>

      <!-- Título principal de rol y propuesta de valor -->
      <h1 class="text-4xl font-bold tracking-tight text-text-primary sm:text-5xl lg:text-6xl">
        Hola, soy Mateo. <br />
        <span class="text-accent">Full Stack Developer</span> enfocado en aplicaciones web y móviles escalables.
      </h1>

      <!-- Párrafo descriptivo con foco en UTN y stack -->
      <p class="text-lg leading-relaxed text-text-muted sm:text-xl">
        Estudiante de la Tecnicatura Universitaria en Programación (UTN). Construyo software combinando rigor de arquitectura en el backend con TypeScript y Node.js, e interfaces dinámicas centradas en la experiencia de usuario con React.
      </p>

      <!-- Botones de Llamado a la Acción (CTAs) -->
      <div class="flex flex-wrap items-center gap-4 pt-4">
        <a
          href="#proyectos"
          class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <span>Explorar Proyectos</span>
          <ArrowRight className="h-4 w-4" />
        </a>

        <a
          href="/cv-mateo-gigy-traynor.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-border-muted bg-bg-surface px-5 py-3 text-sm font-semibold text-text-primary transition hover:border-accent hover:bg-bg-surface/80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          <Download className="h-4 w-4 text-text-muted" />
          <span>Descargar CV</span>
        </a>

        <!-- Enlaces a redes con SVGs inline nativos (Cero problemas de CJS/ESM) -->
        <div class="flex items-center gap-2 border-l border-border-muted pl-4">
          <!-- GitHub -->
          <a
            href="https://github.com/mateoutn2024"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Perfil de GitHub de Mateo"
            class="rounded-lg p-2 text-text-muted transition hover:bg-bg-surface hover:text-text-primary"
          >
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
            </svg>
          </a>

          <!-- LinkedIn -->
          <a
            href="https://www.linkedin.com/in/mateotraynor/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Perfil de LinkedIn de Mateo"
            class="rounded-lg p-2 text-text-muted transition hover:bg-bg-surface hover:text-text-primary"
          >
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.65 1.65 0 1 0 0 3.3 1.65 1.65 0 0 0 0-3.3z"></path>
            </svg>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>